  m_Name: 
  m_EditorClassIdentifier: PoBox.Runtime::PoBox.Rl.MujocoRing
  xml: "<mujoco model=\"trump_vs_nick_spar\">\r\n  <compiler angle=\"degree\" inertiafromgeom=\"true\" autolimits=\"true\"/>\r\n  <option timestep=\"0.005\" iterations=\"10\" ls_iterations=\"10\" integrator=\"implicitfast\">\r\n    <flag eulerdamp=\"disable\"/>\r\n  </option>\r\n  <default>\r\n    <geom contype=\"1\" conaffinity=\"1\" condim=\"3\" friction=\"1.0 0.005 0.0001\" density=\"1000\" margin=\"0\"/>\r\n    <joint limited=\"true\"/>\r\n    <position ctrllimited=\"true\"/>\r\n  </default>\r\n  <asset>\r\n    <texture name=\"grid\" type=\"2d\" builtin=\"checker\" rgb1=\".18 .28 .48\" rgb2=\".14 .22 .40\" width=\"300\" height=\"300\"/>\r\n    <material name=\"grid\" texture=\"grid\" texrepeat=\"6 6\" reflectance=\"0\"/>\r\n  </asset>\r\n  <worldbody>\r\n    <light pos=\"0 0 5\" dir=\"0 0 -1\" directional=\"true\"/>\r\n    <geom name=\"floor\" type=\"plane\" contype=\"3\" conaffinity=\"3\" size=\"0 0 0.05\" material=\"grid\" friction=\"1.0 0.005 0.0001\"/>\r\n    <geom name=\"rope_n\" type=\"box\" pos=\"0.0000 3.1000 0.7500\" size=\"3.1500 0.0500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_s\" type=\"box\" pos=\"0.0000 -3.1000 0.7500\" size=\"3.1500 0.0500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_e\" type=\"box\" pos=\"3.1000 0.0000 0.7500\" size=\"0.0500 3.1500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_w\" type=\"box\" pos=\"-3.1000 0.0000 0.7500\" size=\"0.0500 3.1500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <body name=\"a_pelvis\" pos=\"-0.6000 0.0000 0.9982\" quat=\"1.00000 0 0 0.00000\">\r\n      <freejoint name=\"a_root\"/>\r\n      <geom name=\"a_pelvis_geom\" type=\"capsule\" fromto=\"0.0000 -0.0700 0.0000 0.0000 0.0700 0.0000\" size=\"0.1121\" mass=\"9.6630\" />\r\n      <geom name=\"a_pelvis_up\" type=\"capsule\" fromto=\"0.0000 0.0000 0.0000 -0.0074 0.0000 0.0765\" size=\"0.1009\" mass=\"5.7156\" />\r\n      <body name=\"a_torso\" pos=\"-0.0074 0.0000 0.0965\">\r\n        <joint name=\"a_abdomen_z\" type=\"hinge\" axis=\"0 0 1\" range=\"-45 45\" damping=\"0.5\" armature=\"0.08\" stiffness=\"0\"/>\r\n        <joint name=\"a_abdomen_y\" type=\"hinge\" axis=\"0 1 0\" range=\"-60 30\" damping=\"0.5\" armature=\"0.08\" stiffness=\"0\"/>\r\n        <joint name=\"a_abdomen_x\" type=\"hinge\" axis=\"1 0 0\" range=\"-35 35\" damping=\"0.5\" armature=\"0.08\" stiffness=\"0\"/>\r\n        <geom name=\"a_torso_geom\" type=\"capsule\" fromto=\"0.0000 0.0000 0.0200 -0.0223 0.0000 0.4131\" size=\"0.1121\" mass=\"38.4465\" />\r\n        <geom name=\"a_chest_geom\" type=\"capsule\" fromto=\"-0.0178 -0.1841 0.2257 -0.0178 0.1841 0.2257\" size=\"0.1009\" mass=\"0.5\"/>\r\n        <geom name=\"a_head_geom\" type=\"sphere\" pos=\"-0.0037 0.0000 0.4861\" size=\"0.1250\" mass=\"8.7723\" />\r\n        <body name=\"a_upper_arm_l\" pos=\"-0.0223 0.2301 0.2821\">\r\n          <joint name=\"a_shoulder_x_l\" type=\"hinge\" axis=\"1 0 0\" range=\"-170 30\" damping=\"0.5\" armature=\"0.03\" stiffness=\"0\"/>\r\n          <joint name=\"a_shoulder_z_l\" type=\"hinge\" axis=\"0 0 1\" range=\"-110 110\" damping=\"0.5\" armature=\"0.03\" stiffness=\"0\"/>\r\n          <geom name=\"a_upper_arm_l_geom\" type=\"capsule\" fromto=\"0.0000 0.0000 0.0000 0.0000 0.2324 0.0000\" size=\"0.0580\" mass=\"3.0324\" />\r\n          <body name=\"a_forearm_l\" pos=\"0.0000 0.2324 0.0000\">\r\n            <joint name=\"a_elbow_l\" type=\"hinge\" axis=\"0 0 1\" range=\"-150 0\" damping=\"0.5\" armature=\"0.02\" stiffness=\"0\"/>\r\n            <geom name=\"a_forearm_l_geom\" type=\"capsule\" fromto=\"0.0000 0.0000 0.0000 0.0000 0.2561 0.0000\" size=\"0.0480\" mass=\"1.7328\" />\r\n            <geom name=\"a_glove_l\" type=\"sphere\" pos=\"0.0000 0.3236 0.0000\" size=\"0.0750\" mass=\"0.9328\" rgba=\"0.85 0.2 0.2 1\"/>\r\n          </body>\r\n        </body>\r\n        <body name=\"a_upper_arm_r\" pos=\"-0.0223 -0.2301 0.2821\">\r\n          <joint name=\"a_shoulder_x_r\" type=\"hinge\" axis=\"1 0 0\" rang