  m_Name: 
  m_EditorClassIdentifier: PoBox.Runtime::PoBox.Rl.MujocoRing
  xml: "<mujoco model=\"matt_vs_zombie_spar\">\r\n  <compiler angle=\"degree\" inertiafromgeom=\"true\" autolimits=\"true\"/>\r\n  <option timestep=\"0.005\" iterations=\"10\" ls_iterations=\"10\" integrator=\"implicitfast\">\r\n    <flag eulerdamp=\"disable\"/>\r\n  </option>\r\n  <default>\r\n    <geom contype=\"1\" conaffinity=\"1\" condim=\"3\" friction=\"1.0 0.005 0.0001\" density=\"1000\" margin=\"0\"/>\r\n    <joint limited=\"true\"/>\r\n    <position ctrllimited=\"true\"/>\r\n  </default>\r\n  <asset>\r\n    <texture name=\"grid\" type=\"2d\" builtin=\"checker\" rgb1=\".18 .28 .48\" rgb2=\".14 .22 .40\" width=\"300\" height=\"300\"/>\r\n    <material name=\"grid\" texture=\"grid\" texrepeat=\"6 6\" reflectance=\"0\"/>\r\n  </asset>\r\n  <worldbody>\r\n    <light pos=\"0 0 5\" dir=\"0 0 -1\" directional=\"true\"/>\r\n    <geom name=\"floor\" type=\"plane\" contype=\"3\" conaffinity=\"3\" size=\"0 0 0.05\" material=\"grid\" friction=\"1.0 0.005 0.0001\"/>\r\n    <geom name=\"rope_n\" type=\"box\" pos=\"0.0000 3.1000 0.7500\" size=\"3.1500 0.0500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_s\" type=\"box\" pos=\"0.0000 -3.1000 0.7500\" size=\"3.1500 0.0500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_e\" type=\"box\" pos=\"3.1000 0.0000 0.7500\" size=\"0.0500 3.1500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <geom name=\"rope_w\" type=\"box\" pos=\"-3.1000 0.0000 0.7500\" size=\"0.0500 3.1500 0.7500\" rgba=\"0.8 0.8 0.8 0.15\"/>\r\n    <body name=\"a_pelvis\" pos=\"-0.6000 0.0000 0.9741\" quat=\"1.00000 0 0 0.00000\">\r\n      <freejoint name=\"a_root\"/>\r\n      <geom name=\"a_pelvis_geom\" type=\"capsule\" fromto=\"0.0000 -0.0700 0.0000 0.0000 0.0700 0.0000\" size=\"0.0850\" mass=\"7.0977\" />\r\n      <geom name=\"a_pelvis_up\" type=\"capsule\" fromto=\"0.0000 0.0000 0.0000 -0.0008 0.0000 0.0758\" size=\"0.0765\" mass=\"4.0351\" />\r\n      <body name=\"a_torso\" pos=\"-0.0008 0.0000 0.0958\">\r\n        <joint name=\"a_a