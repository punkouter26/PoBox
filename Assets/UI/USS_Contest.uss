/* Contest HUD theme — single source of style for the test-scene UI.
   Palette matches Systems_UiTheme: Gold rgb(217,173,64), GoldBright
   rgb(255,230,102), PanelDark rgba(13,13,20,0.94). */

.hud-root {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

/* Inset past the corner furniture rather than spanning the full width: a chip
   centred across all 1080 px ran straight under the "MENU" button once the
   round countdown was added to the balance title. The insets are uneven
   because the corners are: at this height the left holds only the version
   stamp (x 18-134), while the right holds the button (x 851-1064). */
.top-bar {
    position: absolute;
    top: 12px;
    left: 150px;
    right: 240px;
    align-items: center;
}

/* max-width is what actually binds the chip — align-items: center alone lets
   an over-wide child spill out of the bar on both sides, which is how the
   title still reached the button after the insets went in. 32 px keeps the
   longest title, "Balance Contest — Round 1  30s", on one line within the
   690 px band; anything longer wraps instead of clipping. */
.title-chip {
    background-color: rgba(13, 13, 20, 0.94);
    color: rgb(255, 255, 255);
    padding: 6px 14px;
    border-radius: 14px;
    font-size: 32px;
    max-width: 100%;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Wraps because eight plates do not fit across 1080 px at this font size, and
   the flex default is to shrink them instead — which clipped every name and
   time in the balance contest ("Standard3  2.7s" needs 204 px, got 141). The
   row is pinned by its bottom edge, so extra lines grow upward off the mat.

   bottom was 14 px, which put the last row of an eight-fighter ring 16 px off
   the bottom of a 1920 px panel — under the gesture bar on any modern phone,
   and touching the edge on all of them. 56 px clears it. */
.plates-row {
    position: absolute;
    bottom: 56px;
    left: 0;
    right: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* A row now, not a bare label: the swatch that identifies the fighter sits
   inside it (Systems_UiTheme.BuildPlate). */
.plate {
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 13, 20, 0.94);
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 4px 10px;
    border-radius: 8px;
    flex-shrink: 0;
}

.plate-label {
    color: rgb(255, 255, 255);
    font-size: 30px;
    white-space: nowrap;
}

/* The fighter's own colour, as a dot. Sized in the same units as the text it
   sits beside so it scales with the plate rather than needing its own tuning,
   and given a dark ring so a pale wash still reads against the panel. */
.plate-swatch {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    border-radius: 11px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.55);
    flex-shrink: 0;
}

/* The modifiers moved from the label to the plate when the plate grew
   children — set on the label, the winner's gold background coloured the text
   box only and left the plate around it dark. */
.plate--down .plate-label {
    color: rgb(255, 110, 100);
}

.plate--winner {
    background-color: rgb(217, 173, 64);
}

.plate--winner .plate-label {
    color: rgb(20, 16, 4);
    -unity-font-style: bold;
}

/* Match star tally. A wrapping row of chips rather than one long label, so a
   full ring's worth of near-identical names cannot run down the screen. */
.score-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.score-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(13, 13, 20, 0.8);
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 2px 12px;
    border-radius: 8px;
    flex-shrink: 0;
}

.score-chip-label {
    color: rgb(217, 173, 64);
    font-size: 38px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.winner-banner {
    position: absolute;
    top: 32%;
    left: 0;
    right: 0;
    align-items: center;
}

.winner-text {
    font-size: 88px;
    color: rgb(255, 230, 102);
    -unity-font-style: bold;
}

.countdown-label {
    position: absolute;
    top: 42%;
    left: 0;
    right: 0;
    font-size: 220px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
