/* Contest HUD theme — single source of style for the test-scene UI.
   Palette matches Systems_UiTheme: Gold rgb(217,173,64), GoldBright
   rgb(255,230,102), PanelDark rgba(13,13,20,0.94). */

.hud-root {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.top-bar {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
}

.title-chip {
    background-color: rgba(13, 13, 20, 0.94);
    color: rgb(255, 255, 255);
    padding: 6px 14px;
    border-radius: 14px;
    font-size: 40px;
    -unity-font-style: bold;
}

/* Wraps because eight plates do not fit across 1080 px at this font size, and
   the flex default is to shrink them instead — which clipped every name and
   time in the balance contest ("Standard3  2.7s" needs 204 px, got 141). The
   row is pinned by its bottom edge, so extra lines grow upward off the mat. */
.plates-row {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.plate {
    background-color: rgba(13, 13, 20, 0.94);
    color: rgb(255, 255, 255);
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 30px;
    flex-shrink: 0;
    white-space: nowrap;
}

.plate--down {
    color: rgb(255, 110, 100);
}

.plate--winner {
    background-color: rgb(217, 173, 64);
    color: rgb(20, 16, 4);
    -unity-font-style: bold;
}

.winner-banner {
    position: absolute;
    top: 32%;
    left: 0;
    right: 0;
    align-items: center;
}

.winner-text {
    font-size: 88px;
    color: rgb(255, 230, 102);
    -unity-font-style: bold;
}

.countdown-label {
    position: absolute;
    top: 42%;
    left: 0;
    right: 0;
    font-size: 220px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
