<?xml version="1.0" encoding="utf-8"?>
<!--
    PoBox: the testbed, on the same stylesheet and the same five anchors as the HUD. TestbedHud.cs fills
    it in. The same warning as in Hud.uxml: no two hyphens in a row inside a comment.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="frame" class="root" picking-mode="Ignore">
        <ui:VisualElement name="frame-top" class="frame-row frame-row--top" picking-mode="Ignore">
            <ui:Label name="title" class="chip frame-title" text="TESTBED" picking-mode="Ignore" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Button name="behaviour" class="btn btn--primary" text="STAND" />
        </ui:VisualElement>

        <ui:VisualElement name="top-centre" class="board" picking-mode="Ignore">
            <ui:Label name="boxer" class="tb-line" text="" picking-mode="Ignore" />
            <ui:Label name="telemetry" class="tb-line" text="" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="frame-bottom" class="frame-row frame-row--bottom">
            <ui:Button name="reset" class="btn tb-btn" text="RESET" />
            <ui:Button name="shove" class="btn tb-btn" text="SHOVES OFF" />
            <ui:Button name="cube" class="btn tb-btn" text="CUBE" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Label name="version" class="chip frame-version" text="" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
