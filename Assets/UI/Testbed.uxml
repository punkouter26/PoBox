<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="frame" picking-mode="Ignore" style="flex-grow: 1; color: rgb(238, 242, 248); font-size: 30px;">
        <ui:VisualElement name="top-left" picking-mode="Ignore" style="position: absolute; left: 28px; top: 28px; background-color: rgba(14, 18, 26, 0.72); border-radius: 14px; padding: 14px 22px;">
            <ui:Label name="title" text="POBOX TESTBED" style="-unity-font-style: bold; font-size: 34px; padding: 0; margin: 0;" />
            <ui:Label name="boxer" text="" style="font-size: 28px; color: rgb(170, 184, 204); padding: 0; margin: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="top-centre" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 148px; align-items: center;">
            <ui:Label name="telemetry" text="" style="background-color: rgba(14, 18, 26, 0.72); border-radius: 14px; padding: 12px 22px; font-size: 28px; -unity-text-align: upper-center; white-space: normal;" />
        </ui:VisualElement>
        <ui:VisualElement name="top-right" style="position: absolute; right: 28px; top: 28px;">
            <ui:Button name="behaviour" text="STAND" style="min-width: 250px; min-height: 96px; font-size: 32px; -unity-font-style: bold; border-radius: 14px; border-width: 0; background-color: rgb(46, 110, 220); color: rgb(255, 255, 255); margin: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-left" style="position: absolute; left: 28px; bottom: 28px; flex-direction: row;">
            <ui:Button name="reset" text="RESET" style="min-width: 190px; min-height: 96px; font-size: 32px; -unity-font-style: bold; border-radius: 14px; border-width: 0; background-color: rgb(52, 60, 76); color: rgb(255, 255, 255); margin: 0 14px 0 0;" />
            <ui:Button name="shove" text="SHOVES OFF" style="min-width: 250px; min-height: 96px; font-size: 32px; -unity-font-style: bold; border-radius: 14px; border-width: 0; background-color: rgb(52, 60, 76); color: rgb(255, 255, 255); margin: 0 14px 0 0;" />
            <ui:Button name="cube" text="CUBE" style="min-width: 170px; min-height: 96px; font-size: 32px; -unity-font-style: bold; border-radius: 14px; border-width: 0; background-color: rgb(196, 148, 40); color: rgb(20, 20, 20); margin: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-right" picking-mode="Ignore" style="position: absolute; right: 28px; bottom: 28px; background-color: rgba(14, 18, 26, 0.72); border-radius: 14px; padding: 10px 18px;">
            <ui:Label name="version" text="" style="font-size: 26px; color: rgb(170, 184, 204); padding: 0; margin: 0; -unity-text-align: lower-right;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
