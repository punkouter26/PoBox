<?xml version="1.0" encoding="utf-8"?>
<!--
    PoBox: the whole interface in one document, laid out for a 1080 x 1920 portrait screen.

    Five anchors that never move:
        top-left      the game's name
        top-centre    the frame rate (tap: frame-time graph and the debug panel)
        top-right     the menu (three bars; a cross while it is open)
        bottom-left   DEBUG
        bottom-right  the version

    Between them, top to bottom: the scoreboard, the picture, the dock (one graph).

    The scoreboard is three rows. The names sit on the health bars with the clock between them; under
    that the win-probability bar; under that three chips, each a pair of numbers either side of an icon
    (landed, hardest hit, and a third that cycles on a tap). In the picture's top corners are two small
    pods, one a fighter: where it has been hit, and where its balance is. The commentary is a caption
    over the bottom of the picture that goes away when it has nothing to say.

    The menu, the debug panel and the results card are absolutely positioned and open over that, docked at
    the bottom and one at a time; nothing here scrolls and nothing pushes anything else off the screen.
    A tap on the picture closes the menu. HudView.cs fills in the numbers.

    A warning for whoever edits this: XML does not allow two hyphens in a row inside a comment, and the
    importer answers by silently producing an empty document. Class names with a double hyphen stay out
    of comments.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Theme.uss" />

    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore">

            <!-- Under everything else: a sideways drag on the picture takes the orbit camera and turns it. -->
            <ui:VisualElement name="picture" class="picture" />

            <ui:VisualElement name="frame-top" class="frame-row frame-row--top" picking-mode="Ignore">
                <ui:Label name="title" class="chip frame-title" text="POBOX" picking-mode="Ignore" />
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:Button name="menu" class="btn btn--ghost btn--icon">
                    <PoBox.UI.Glyph name="menu-glyph" kind="Menu" class="glyph--btn" />
                </ui:Button>
                <ui:VisualElement class="frame-centre" picking-mode="Ignore">
                    <ui:Button name="fps" class="chip frame-fps" text="-- FPS" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="board" class="board" picking-mode="Ignore">
                <ui:VisualElement class="board-row" picking-mode="Ignore">
                    <ui:VisualElement class="plate plate--red" picking-mode="Ignore">
                        <ui:VisualElement name="red-hp" class="plate-fill plate-fill--red" picking-mode="Ignore" />
                        <ui:Label name="red-name" class="plate-name" text="RED" picking-mode="Ignore" />
                        <ui:Label name="red-badge" class="plate-rank" text="#1" picking-mode="Ignore" />
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:Label name="red-hp-text" class="plate-hp" text="100" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="clock" picking-mode="Ignore">
                        <ui:Label name="round" class="clock-round" text="R1" picking-mode="Ignore" />
                        <ui:Label name="clock" class="clock-time" text="0:45" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="plate plate--blue" picking-mode="Ignore">
                        <ui:VisualElement name="blue-hp" class="plate-fill plate-fill--blue" picking-mode="Ignore" />
                        <ui:Label name="blue-name" class="plate-name" text="BLUE" picking-mode="Ignore" />
                        <ui:Label name="blue-badge" class="plate-rank" text="#2" picking-mode="Ignore" />
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:Label name="blue-hp-text" class="plate-hp" text="100" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="momentum" class="momentum" picking-mode="Ignore">
                    <ui:VisualElement name="momentum-fill" class="momentum-fill" picking-mode="Ignore" />
                    <ui:VisualElement class="momentum-mid" picking-mode="Ignore" />
                    <ui:Label name="momentum-red" class="momentum-text momentum-text--l" text="50%" picking-mode="Ignore" />
                    <ui:Label name="momentum-blue" class="momentum-text momentum-text--r" text="50%" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="tape" class="chips" picking-mode="Ignore">
                    <ui:VisualElement class="stat" picking-mode="Ignore">
                        <ui:Label name="landed-red" class="stat-val stat-val--l" text="0/0" picking-mode="Ignore" />
                        <PoBox.UI.Glyph kind="Glove" class="glyph" />
                        <ui:Label name="landed-blue" class="stat-val stat-val--r" text="0/0" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat" picking-mode="Ignore">
                        <ui:Label name="peak-red" class="stat-val stat-val--l" text="0 N·s" picking-mode="Ignore" />
                        <PoBox.UI.Glyph kind="Burst" class="glyph" />
                        <ui:Label name="peak-blue" class="stat-val stat-val--r" text="0 N·s" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="cycle" class="stat stat--tap">
                        <ui:Label name="cycle-red" class="stat-val stat-val--l" text="0.0 kJ" picking-mode="Ignore" />
                        <PoBox.UI.Glyph name="cycle-glyph" kind="Bolt" class="glyph glyph--tap" />
                        <ui:Label name="cycle-blue" class="stat-val stat-val--r" text="0.0 kJ" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="pod-red" class="pod pod--red" picking-mode="Ignore">
                <PoBox.UI.HitMap name="hit-red" class="hitmap" />
                <PoBox.UI.BalanceGauge name="bal-red" class="balance" />
                <ui:VisualElement class="tank" picking-mode="Ignore">
                    <ui:VisualElement name="tank-red" class="tank-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="act-red" class="act" text="GUARD" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="pod-blue" class="pod pod--blue" picking-mode="Ignore">
                <PoBox.UI.HitMap name="hit-blue" class="hitmap" mirror="true" />
                <PoBox.UI.BalanceGauge name="bal-blue" class="balance" />
                <ui:VisualElement class="tank" picking-mode="Ignore">
                    <ui:VisualElement name="tank-blue" class="tank-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="act-blue" class="act" text="GUARD" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:Label name="banner" class="banner hidden" text="ROUND 1" picking-mode="Ignore" />

            <ui:VisualElement name="walkon" class="walkon hidden" picking-mode="Ignore">
                <ui:VisualElement name="walkon-bar" class="walkon-bar" picking-mode="Ignore" />
                <ui:VisualElement class="walkon-text" picking-mode="Ignore">
                    <ui:Label name="walkon-corner" class="walkon-corner" text="RED CORNER" picking-mode="Ignore" />
                    <ui:Label name="walkon-name" class="walkon-name" text="RED" picking-mode="Ignore" />
                    <ui:Label name="walkon-detail" class="walkon-detail" text="" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Between rounds: the three cards as they stand, and what each boxer did in the round just ended. -->
            <ui:VisualElement name="break" class="break hidden" picking-mode="Ignore">
                <ui:Label name="break-title" class="break-title" text="END OF ROUND 1" picking-mode="Ignore" />
                <ui:VisualElement name="break-judges" class="judges" picking-mode="Ignore" />
                <ui:VisualElement class="chips" picking-mode="Ignore">
                    <ui:VisualElement class="stat" picking-mode="Ignore">
                        <ui:Label name="break-landed-red" class="stat-val stat-val--l" text="0/0" picking-mode="Ignore" />
                        <PoBox.UI.Glyph kind="Glove" class="glyph" />
                        <ui:Label name="break-landed-blue" class="stat-val stat-val--r" text="0/0" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stat" picking-mode="Ignore">
                        <ui:Label name="break-blocked-red" class="stat-val stat-val--l" text="0" picking-mode="Ignore" />
                        <PoBox.UI.Glyph kind="Shield" class="glyph" />
                        <ui:Label name="break-blocked-blue" class="stat-val stat-val--r" text="0" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- During a count: the boxer left standing, while the main picture is on the one on the canvas. -->
            <ui:VisualElement name="pip" class="pip hidden" picking-mode="Ignore" />

            <!-- A hard clean punch: the glove's speed, written where it landed. -->
            <ui:Label name="flash" class="flash hidden" text="" picking-mode="Ignore" />

            <ui:Label name="ticker" class="ticker" text="" picking-mode="Ignore" />

            <ui:VisualElement name="dock" class="dock" picking-mode="Ignore">
                <ui:VisualElement name="strip" class="strip">
                    <ui:VisualElement class="strip-head" picking-mode="Ignore">
                        <ui:Label name="strip-title" class="strip-title" text="EXCITEMENT" picking-mode="Ignore" />
                        <ui:Label name="strip-value" class="strip-value" text="0%" picking-mode="Ignore" />
                        <ui:VisualElement class="spacer" picking-mode="Ignore" />
                        <ui:VisualElement name="dot0" class="dot dot--page" picking-mode="Ignore" />
                        <ui:VisualElement name="dot1" class="dot dot--page" picking-mode="Ignore" />
                        <ui:VisualElement name="dot2" class="dot dot--page" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <PoBox.UI.Sparkline name="strip-graph" class="strip-graph" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="results" class="sheet results hidden">
                <ui:VisualElement class="res-head" picking-mode="Ignore">
                    <ui:VisualElement class="icon icon--trophy res-icon" picking-mode="Ignore" />
                    <ui:VisualElement class="res-title" picking-mode="Ignore">
                        <ui:Label name="res-winner" class="res-winner" text="RED WINS" picking-mode="Ignore" />
                        <ui:Label name="res-method" class="res-method" text="UNANIMOUS DECISION" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="res-elo" class="badge badge--big" text="+0 ELO" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="res-judges" class="judges" picking-mode="Ignore" />
                <ui:VisualElement class="res-mid" picking-mode="Ignore">
                    <PoBox.UI.HitMap name="res-hit-red" class="res-hitmap" />
                    <ui:VisualElement name="res-tape" class="tape tape--card" picking-mode="Ignore" />
                    <PoBox.UI.HitMap name="res-hit-blue" class="res-hitmap" mirror="true" />
                </ui:VisualElement>
                <PoBox.UI.Sparkline name="res-graph" class="res-graph" />
                <ui:VisualElement class="res-actions" picking-mode="Ignore">
                    <ui:Button name="res-boxers" class="btn btn--tool">
                        <ui:VisualElement class="icon icon--return" picking-mode="Ignore" />
                        <ui:Label class="btn-word" text="BOXERS" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="res-next" class="btn btn--primary res-go" text="NEXT BOUT" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="menu-sheet" class="sheet menu-sheet hidden">
                <ui:VisualElement class="seg" picking-mode="Ignore">
                    <ui:Button name="tab-match" class="seg-btn seg-btn--on" text="MATCH" />
                    <ui:Button name="tab-league" class="seg-btn" text="LEAGUE" />
                    <ui:Button name="tab-settings" class="seg-btn" text="SETTINGS" />
                </ui:VisualElement>

                <ui:VisualElement name="page-match" class="page" picking-mode="Ignore">
                    <ui:VisualElement class="grid" picking-mode="Ignore">
                        <ui:Button name="m-restart" class="btn btn--tool grid-2">
                            <ui:VisualElement class="icon icon--return" picking-mode="Ignore" />
                            <ui:Label class="btn-word" text="RESTART" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="m-next" class="btn btn--tool grid-2">
                            <ui:VisualElement class="icon icon--next" picking-mode="Ignore" />
                            <ui:Label class="btn-word" text="NEXT BOUT" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label class="label-micro page-label" text="CAMERA" picking-mode="Ignore" />
                    <ui:VisualElement class="grid" picking-mode="Ignore">
                        <ui:Button name="cam-auto" class="btn grid-4" text="AUTO" />
                        <ui:Button name="cam-wide" class="btn grid-4" text="WIDE" />
                        <ui:Button name="cam-orbit" class="btn grid-4" text="ORBIT" />
                        <ui:Button name="cam-top" class="btn grid-4" text="TOP" />
                        <ui:Button name="cam-red" class="btn grid-4 btn--tool">
                            <PoBox.UI.Glyph kind="Glove" class="glyph--btn glyph--red" />
                        </ui:Button>
                        <ui:Button name="cam-blue" class="btn grid-4 btn--tool">
                            <PoBox.UI.Glyph kind="Glove" class="glyph--btn glyph--blue" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label class="label-micro page-label" text="SPEED" picking-mode="Ignore" />
                    <ui:VisualElement class="grid" picking-mode="Ignore">
                        <ui:Button name="spd-one" class="btn grid-2" text="1x" />
                        <ui:Button name="spd-two" class="btn grid-2" text="2x" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid grid--last" picking-mode="Ignore">
                        <ui:Button name="m-boxers" class="btn btn--tool grid-2">
                            <ui:VisualElement class="icon icon--return" picking-mode="Ignore" />
                            <ui:Label class="btn-word" text="CHANGE BOXERS" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="page-league" class="page hidden" picking-mode="Ignore" />

                <ui:VisualElement name="page-settings" class="page hidden" picking-mode="Ignore">
                    <ui:VisualElement class="grid" picking-mode="Ignore">
                        <ui:Button name="s-sound" class="btn grid-2" text="SOUND ON" />
                        <ui:Button name="s-quality" class="btn grid-2" text="QUALITY PC" />
                    </ui:VisualElement>
                    <ui:VisualElement class="grid" picking-mode="Ignore">
                        <ui:Button name="s-fps" class="btn grid-2" text="60 FPS" />
                        <ui:Button name="s-reset" class="btn grid-2" text="RESET LADDER" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="debug-panel" class="debug-panel hidden" picking-mode="Ignore" />

            <ui:VisualElement name="frame-bottom" class="frame-row frame-row--bottom" picking-mode="Ignore">
                <ui:Button name="debug" class="chip frame-debug">
                    <ui:VisualElement name="debug-dot" class="dot" picking-mode="Ignore" />
                    <ui:Label name="debug-text" class="frame-debug-text" text="DEBUG" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement class="spacer" picking-mode="Ignore" />
                <ui:Label name="version" class="chip frame-version" text="v0.0.0" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
