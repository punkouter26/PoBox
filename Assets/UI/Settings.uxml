<?xml version="1.0" encoding="utf-8"?>
<!--
    PoBox: the settings, one template used by the HUD's menu (Hud.uxml), the first screen (Menu.uxml) and the
    free-for-all (Melee.uxml). SettingsPage.cs fills it in. Every option of the game is here, three tabs on one
    sheet, nothing scrolls. The defaults are the plain broadcast: everything a viewer does not need is off.

        SOUND     the sound, the commentator's voice, the buzz of a hit, bullet time
        VIEW      the picture's quality, the frame rate, STATS (the numbers: the hit maps, the balance gauges, the
                  punch card, the glove speed on a hard punch, the frame rate and the version) and BETS (the
                  coin pick before the first bell); both off unless chosen
        MORE      the collision shapes (where there are boxers), the brain cam (arena only), the readings, throwing
                  the ladder away (arena only), the Twitch channel for chat plays and the cornerman's proxy

    A switch is an icon and a short word with a dot that is lit while it is on; its tooltip says ON or OFF.
    RESET (the ladder) turns red and asks SURE? before it throws anything away.

    The same warning as in Hud.uxml: no two hyphens in a row inside a comment.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="seg" picking-mode="Ignore">
        <ui:Button name="s-tab-sound" class="seg-btn seg-btn--on" text="SOUND" />
        <ui:Button name="s-tab-view" class="seg-btn" text="VIEW" />
        <ui:Button name="s-tab-more" class="seg-btn" text="MORE" />
    </ui:VisualElement>

    <ui:VisualElement name="s-page-sound" class="s-page" picking-mode="Ignore">
        <ui:VisualElement class="grid" picking-mode="Ignore">
            <ui:Button name="s-sound" class="btn btn--tool grid-2" tooltip="Sound">
                <PoBox.UI.Glyph kind="Speaker" class="glyph--btn" />
                <ui:Label class="btn-word" text="SOUND" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-voice" class="btn btn--tool grid-2" tooltip="Commentator's voice">
                <PoBox.UI.Glyph kind="Voice" class="glyph--btn" />
                <ui:Label class="btn-word" text="VOICE" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement class="grid" picking-mode="Ignore">
            <ui:Button name="s-buzz" class="btn btn--tool grid-2" tooltip="Buzz on a hit">
                <PoBox.UI.Glyph kind="Buzz" class="glyph--btn" />
                <ui:Label class="btn-word" text="BUZZ" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-bullet" class="btn btn--tool grid-2" tooltip="Bullet time on a big punch">
                <PoBox.UI.Glyph kind="Burst" class="glyph--btn" />
                <ui:Label class="btn-word" text="SLOW-MO" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="s-page-view" class="s-page hidden" picking-mode="Ignore">
        <ui:VisualElement class="grid" picking-mode="Ignore">
            <ui:Button name="s-quality" class="btn btn--tool grid-2" tooltip="Picture quality">
                <ui:Label class="btn-word btn-word--lead" text="QUALITY" picking-mode="Ignore" />
                <ui:Label name="s-quality-badge" class="badge badge--btn" text="PC" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-fps" class="btn grid-2" text="60 FPS" tooltip="Frame rate cap" />
        </ui:VisualElement>
        <ui:VisualElement class="grid" picking-mode="Ignore">
            <ui:Button name="s-stats" class="btn btn--tool grid-2" tooltip="The numbers: hit maps, balance, punch card, glove speed, frame rate">
                <PoBox.UI.Glyph kind="Balance" class="glyph--btn" />
                <ui:Label class="btn-word" text="STATS" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-bets" class="btn btn--tool grid-2" tooltip="Pick a corner with coins before the first bell">
                <PoBox.UI.Glyph kind="Glove" class="glyph--btn" />
                <ui:Label class="btn-word" text="BETS" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="s-page-more" class="s-page hidden" picking-mode="Ignore">
        <!-- One row of four: two rows of two and the two fields were taller than the page and lay over each other. -->
        <ui:VisualElement class="grid" picking-mode="Ignore">
            <ui:Button name="s-xray" class="btn btn--tool grid-4" tooltip="Collision shapes over the boxers">
                <ui:Label class="btn-word btn-word--lead" text="X-RAY" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-brain" class="btn btn--tool grid-4" tooltip="Brain cam: a boxer's joint targets">
                <ui:Label class="btn-word btn-word--lead" text="BRAIN" picking-mode="Ignore" />
                <ui:VisualElement class="sw-dot" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-telemetry" class="btn btn--tool grid-4" tooltip="The debug readings">
                <PoBox.UI.Glyph kind="Power" class="glyph--btn" />
                <ui:Label class="btn-word" text="READINGS" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="s-reset" class="btn btn--tool grid-4" tooltip="Throw the ladder away">
                <PoBox.UI.Glyph name="s-reset-glyph" kind="Trash" class="glyph--btn" />
                <ui:Label name="s-reset-word" class="btn-word" text="RESET" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <!-- Chat plays: the channel whose chat votes and throws cubes. Empty is off; it takes effect at the next fight. -->
        <ui:VisualElement class="field-row" picking-mode="Ignore">
            <ui:Label class="field-key" text="TWITCH" picking-mode="Ignore" />
            <ui:TextField name="s-twitch" class="field" max-length="25" is-delayed="true" />
        </ui:VisualElement>
        <!-- The cornerman proxy (server/corner_proxy.py): Claude's corner advice and the winner's word. Empty is off (the rule-based tips). -->
        <ui:VisualElement class="field-row" picking-mode="Ignore">
            <ui:Label class="field-key" text="CORNER" picking-mode="Ignore" />
            <ui:TextField name="s-corner" class="field" max-length="120" is-delayed="true" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
