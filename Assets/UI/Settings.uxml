<?xml version="1.0" encoding="utf-8"?>
<!--
    PoBox: the settings page, one template used by the HUD's menu (Hud.uxml) and the first screen's
    (Menu.uxml). SettingsPage.cs fills it in. Each button is an icon and a word; the quality button carries
    the level as a badge; RESET LADDER turns red and asks SURE? before it throws anything away.

    The same warning as in Hud.uxml: no two hyphens in a row inside a comment.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="grid" picking-mode="Ignore">
        <ui:Button name="s-sound" class="btn btn--tool grid-2">
            <PoBox.UI.Glyph kind="Speaker" class="glyph--btn" />
            <ui:Label name="s-sound-word" class="btn-word" text="SOUND ON" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="s-quality" class="btn btn--tool grid-2">
            <ui:Label class="btn-word btn-word--lead" text="QUALITY" picking-mode="Ignore" />
            <ui:Label name="s-quality-badge" class="badge badge--btn" text="PC" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement class="grid" picking-mode="Ignore">
        <ui:Button name="s-voice" class="btn btn--tool grid-2">
            <PoBox.UI.Glyph kind="Voice" class="glyph--btn" />
            <ui:Label name="s-voice-word" class="btn-word" text="VOICE ON" picking-mode="Ignore" />
        </ui:Button>
        <ui:Button name="s-buzz" class="btn btn--tool grid-2">
            <PoBox.UI.Glyph kind="Buzz" class="glyph--btn" />
            <ui:Label name="s-buzz-word" class="btn-word" text="BUZZ ON" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement class="grid" picking-mode="Ignore">
        <ui:Button name="s-fps" class="btn grid-2" text="60 FPS" />
        <ui:Button name="s-reset" class="btn btn--tool grid-2">
            <PoBox.UI.Glyph name="s-reset-glyph" kind="Trash" class="glyph--btn" />
            <ui:Label name="s-reset-word" class="btn-word" text="RESET LADDER" picking-mode="Ignore" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
