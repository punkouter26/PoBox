/*
 * PoBox UI theme. One stylesheet for the whole interface.
 *
 * Same house rules as PoDecath, so the two games read as a pair:
 *
 *  - The reference screen is 1080 x 1920 and the panel scales to the device, so every number below is in
 *    reference pixels. A reference pixel is about 0.38 dp on a phone, which is why the smallest text here
 *    is 26 px: anything less is under 10 sp and stops being readable.
 *
 *  - Spacing is on a 4 px grid. Furniture laid over the picture (chips, the scoreboard, the dock) gets 8 px
 *    gaps and at most 16 px of padding; only the sheets, which are cards, get 20.
 *
 *  - Anything a thumb presses is at least 88 px tall (a 44 pt target at 2x), however tight the rest is.
 *
 *  - Nothing scrolls. A panel that does not fit is a panel with too much in it.
 *
 *  - Colours, corner radii and text sizes come from the tokens below, and the documents (Hud, Menu, Melee,
 *    Testbed, Settings) carry no styles of their own. Corners are 6, 8, 12 or 16 (a circle is half its own
 *    size); text is 26, 28, 32, 40 or 52. The exceptions are the three things meant to be read across a room:
 *    the walk-on name (76), the round banner (96) and the referee's count (220).
 *
 *  - Every screen has the same five anchors: its name top-left, the frame rate top-centre, the settings
 *    top-right, DEBUG bottom-left and the version bottom-right (LayoutAudit checks all five on each).
 *
 *  - What opens over the picture (settings, results, the cup, debug) is docked at the bottom, where a thumb
 *    is, one at a time; the picture keeps the top of the screen. Each of them carries the class "over", which
 *    is how the one-screen audit (LayoutAudit.cs) knows it may lie over the furniture and must never lie over
 *    another.
 *
 *  - A name is never allowed to push its neighbours about: every label that shows one is cut short with an
 *    ellipsis (the clamp rule under "base"), and the audit takes such a label as fitting by design.
 *
 *  - Where something sits is a token, never a number written into its rule: the screen is cut into bands
 *    (the frame rows, the scoreboard, the overlays over the picture, the dock) and every offset below is
 *    one of the band edges in :root. USS has no calc(), so each edge is written out with its sum beside it;
 *    change a band and change the sums with it.
 */

:root {
    --ink:            rgb(240, 244, 249);
    --ink-dim:        rgb(168, 178, 192);
    --ink-faint:      rgb(116, 126, 140);

    /* Opaque, both of them. The panel blends in linear space, where four per cent of white text showing
       through a 96% dark card comes out as a clearly readable grey: anything laid over other interface
       has to hide it completely. Only furniture over the picture (--overlay) is see-through. */
    --scrim:          rgb(7, 9, 14);
    --surface:        rgb(14, 17, 25);
    --surface-2:      rgba(34, 40, 54, 0.98);
    --surface-line:   rgba(255, 255, 255, 0.10);
    --overlay:        rgba(6, 8, 14, 0.78);
    --row:            rgba(255, 255, 255, 0.05);
    --row-lead:       rgba(255, 255, 255, 0.11);
    --shade:          rgba(0, 0, 0, 0.35);

    --accent:         rgb(46, 191, 140);
    --accent-hover:   rgb(60, 210, 156);
    --accent-press:   rgb(32, 150, 110);
    --accent-tint:    rgba(46, 191, 140, 0.18);
    --accent-tint-2:  rgba(46, 191, 140, 0.32);
    /* Text on a filled accent, danger or warning button. */
    --on-accent:      rgb(6, 20, 15);
    --on-danger:      rgb(30, 6, 4);
    --danger:         rgb(255, 108, 92);
    --warn:           rgb(255, 198, 84);
    --red:            rgb(226, 62, 62);
    --blue:           rgb(52, 124, 240);
    /* What a fighter has left in its muscles (MjBoxer.Reserve), beside the tank of joint work. */
    --reserve:        rgb(120, 196, 255);
    /* The pale chunk of a health bar that a hit has just taken, before it drains away. */
    --ghost:          rgba(255, 255, 255, 0.55);
    /* Under text laid straight on the picture. */
    --shadow:         rgba(0, 0, 0, 0.8);

    --t-micro:        26px;
    --t-small:        28px;
    --t-body:         32px;
    --t-title:        40px;
    --t-display:      52px;
    --t-hero:         76px;          /* a name on the walk-on card */
    --t-banner:       96px;          /* ROUND 3, KO */
    --t-count:       220px;          /* the referee's count */

    --gap-1:           4px;
    --gap-2:           8px;
    --gap-3:          12px;
    --gap-4:          16px;
    --gap-5:          20px;

    /* Anything a thumb presses is at least this tall (a 44 pt target at 2x). */
    --touch:          88px;

    /* Height of a frame row and the distance anything else keeps from the top and bottom edges. */
    --frame-row:      88px;
    --frame-clear:   104px;          /* gap-2 + frame-row + gap-2 */

    /* The bands of the HUD, from the top. */
    --board-h:       208px;          /* the scoreboard: 12 + plates 72 + 8 + win bar 40 + 8 + chips 56 + 12 */
    --under-board:   320px;          /* frame-clear + board-h + gap-2: where the overlays on the picture start */
    --pod-w:         132px;
    --beside-pods:   156px;          /* gap-4 + pod-w + gap-2: what a full-width overlay leaves either side for the pods */
    --banner-top:    470px;          /* under-board + 150: the round's name across the middle of the pods */
    --count-top:     500px;          /* under-board + 180 */
    --break-top:     776px;          /* under-board + the tallest a pod gets (about 444, both flags up) + gap-3 */

    /* And from the bottom. */
    --over-dock:     112px;          /* frame-clear + gap-2: the caption sits on the bottom row */
    --over-caption:  184px;          /* over-dock + caption 56 + gap-4: the inset sits on the caption */
    --walkon-bottom: 324px;          /* over-caption + 140 */

    /* The free-for-all, from the top. */
    --ffa-under-board: 280px;        /* frame-clear + two rows of (80 + 6) + gap-1 */
    --ffa-call-top:    328px;        /* ffa-under-board + chat 40 + gap-2 */

    /* The first screen. */
    --fight-h:       144px;
    --picker-bottom: 264px;          /* frame-clear + fight-h + gap-4 */

    --radius-lg:      16px;
    --radius:         12px;
    --radius-sm:       8px;
    --radius-xs:       6px;
}

/* ------------------------------------------------------------------ base */

Label { margin: 0; padding: 0; }

.root {
    flex-grow: 1;
    color: var(--ink);
    font-size: var(--t-body);
}

/* The safe area. Its edges are set in code from Screen.safeArea; everything lives inside it. */
.safe {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.spacer { flex-grow: 1; }
.hidden { display: none; }
/* The settings' STATS off (Ui.Frame): the numbers, the frame rate, DEBUG and the version are out of the layout. */
.plain .stats-only { display: none; }

.label-micro { font-size: var(--t-micro); letter-spacing: 2px; color: var(--ink-dim); }

/* The clamp: a name, a pairing or a line of chat is cut short with an ellipsis rather than widening its box. */
.plate-name, .ffa-name, .pick-name, .walkon-name, .res-winner, .lg-name, .cup-line, .predict-btn, .fight-pair, .chat, .brain-title, .ticker {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ------------------------------------------------------------------ buttons */

.btn {
    background-color: var(--surface-2);
    border-radius: var(--radius-sm);
    border-width: 0;
    color: var(--ink);
    font-size: var(--t-body);
    -unity-font-style: bold;
    padding: 0 20px;
    margin: 0;
    height: var(--touch);
    min-height: var(--touch);
    transition-property: background-color, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.btn:hover { background-color: var(--accent-tint); }
.btn:active { scale: 0.97 0.97; background-color: var(--accent-press); }

.btn--primary { background-color: var(--accent); color: var(--on-accent); }
.btn--primary:hover { background-color: var(--accent-hover); }
.btn--primary .icon { -unity-background-image-tint-color: var(--on-accent); }
.btn--ghost { background-color: var(--overlay); }
.btn--on { background-color: var(--accent-tint-2); border-width: 2px; border-color: var(--accent); }
.btn--danger { background-color: var(--danger); color: var(--on-danger); }
.btn--danger .glyph--btn { color: var(--on-danger); }
/* A button whose scene is loading: dimmed, its word trailing dots (MenuView, HudView). */
.btn--busy { opacity: 0.55; }

/* An icon and a word side by side, and an icon alone. */
.btn--tool { flex-direction: row; align-items: center; justify-content: center; }
.btn--icon { width: var(--touch); padding: 0; align-items: center; justify-content: center; }
.btn-word { font-size: var(--t-body); -unity-font-style: bold; margin-left: 10px; }
.btn-word--lead { margin-left: 0; }
.badge--btn { font-size: var(--t-small); margin: 0 0 0 12px; padding: 4px 10px; color: var(--ink); background-color: var(--shade); -unity-font-style: bold; }

/* A switch (the settings): its icon, a short caption, and a dot that is lit while it is on. The word ON or
   OFF is not written; the button's tooltip says it for whoever cannot see the dot. */
.sw-dot { width: 18px; height: 18px; border-radius: 9px; margin-left: 14px; background-color: var(--ink-faint); flex-shrink: 0; }
.btn--on .sw-dot { background-color: var(--ink); }
.btn--on .btn-word { color: var(--ink); }

.icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink);
}
.icon--trophy { background-image: url("project://database/Assets/UI/Icons/trophy.png"); }
.icon--return { background-image: url("project://database/Assets/UI/Icons/return.png"); }
.icon--next   { background-image: url("project://database/Assets/UI/Icons/next.png"); }
.icon--gear   { background-image: url("project://database/Assets/UI/Icons/gear.png"); }
.icon--home   { background-image: url("project://database/Assets/UI/Icons/home.png"); }
.icon--movie  { background-image: url("project://database/Assets/UI/Icons/movie.png"); }

/* ------------------------------------------------------------------ frame: the five anchors */

.frame-row {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    height: var(--frame-row);
    flex-direction: row;
    align-items: center;
}
.frame-row--top { top: var(--gap-2); }
.frame-row--bottom { bottom: var(--gap-2); }

.chip {
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    border-width: 0;
    margin: 0;
    padding: 0 20px;
    /* Two of the four are pressed, so all four are a thumb tall. */
    height: var(--frame-row);
    color: var(--ink);
    font-size: var(--t-body);
    -unity-text-align: middle-center;
}

.frame-title { -unity-font-style: bold; letter-spacing: 3px; }

/* The frame-rate chip is centred on the screen, not on the space left between its neighbours. */
.frame-centre {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}
.frame-fps { min-width: 190px; -unity-font-style: bold; }
.frame-fps--warn { color: var(--warn); }
.frame-fps--bad { color: var(--danger); }

/* An icon drawn in a button: three bars for the menu, a glove in a corner's colour for that boxer. */
.glyph--btn { width: 44px; height: 44px; margin: 0; color: var(--ink); flex-shrink: 0; }
.glyph--red { color: var(--red); }
.glyph--blue { color: var(--blue); }

.frame-debug { flex-direction: row; align-items: center; }
.frame-debug-text { font-size: var(--t-body); margin-left: 12px; }
/* The version: small and quiet, it is only there to be quoted in a bug report. */
.frame-version { color: var(--ink-dim); font-size: var(--t-micro); padding: 0 16px; }

.dot { width: 20px; height: 20px; border-radius: 10px; background-color: var(--accent); }
.dot--warn { background-color: var(--warn); }
.dot--bad { background-color: var(--danger); }
.dot--on { background-color: var(--ink); }

/* ------------------------------------------------------------------ scoreboard */

.board {
    position: absolute;
    top: var(--frame-clear);
    left: var(--gap-4);
    right: var(--gap-4);
    height: var(--board-h);
    background-color: var(--overlay);
    border-radius: var(--radius);
    padding: 12px 16px;
}

.board-row { flex-direction: row; align-items: center; height: 72px; }

/* A name plate is the fighter's health bar: the name and the number are written on it, and the coloured
   part of it is the health that is left. Each bar is anchored at its own outer edge, so both empty
   towards the clock. */
.plate {
    flex: 1 1 0;
    height: 72px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    border-radius: var(--radius-sm);
    background-color: var(--row-lead);
    overflow: hidden;
}
.plate--blue { flex-direction: row-reverse; }
.plate-fill { position: absolute; top: 0; bottom: 0; width: 100%; }
.plate-fill--red { left: 0; background-color: var(--red); }
.plate-fill--blue { right: 0; background-color: var(--blue); }
/* Under the fill: the health a hit has just taken, left pale for a moment and then drained to the fill. */
.plate-ghost {
    position: absolute;
    top: 0; bottom: 0;
    width: 100%;
    background-color: var(--ghost);
    transition-property: width;
    transition-duration: 0.35s;
    transition-delay: 0.6s;
    transition-timing-function: ease-in;
}
.plate-ghost--red { left: 0; }
.plate-ghost--blue { right: 0; }
/* The name gives way first: the rank and the health keep their width and the name ends in an ellipsis. */
.plate-name { font-size: var(--t-title); -unity-font-style: bold; flex-shrink: 1; text-shadow: 0 2px 4px var(--shadow); }
.plate-rank {
    font-size: var(--t-micro);
    background-color: var(--shade);
    border-radius: var(--radius-xs);
    padding: 2px 8px;
    margin: 0 10px;
    flex-shrink: 0;
}
.plate-hp { font-size: var(--t-body); -unity-font-style: bold; flex-shrink: 0; text-shadow: 0 2px 4px var(--shadow); }

/* A number that has just changed, or a badge that has just gone up, swells for a tenth of a second (HudView.Pop). */
.plate-hp, .stat-val, .judge-card, .pod-flag { transition-property: scale; transition-duration: 0.15s; transition-timing-function: ease-out; }
.pop { scale: 1.3 1.3; }

.badge {
    font-size: var(--t-micro);
    background-color: var(--row-lead);
    border-radius: var(--radius-xs);
    padding: 2px 8px;
    margin: 0 8px;
    color: var(--ink-dim);
    flex-shrink: 0;
}
.badge--big { font-size: var(--t-body); padding: 8px 16px; margin: 0; color: var(--ink); -unity-font-style: bold; }

.clock { width: 230px; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.clock-round { font-size: var(--t-small); color: var(--warn); -unity-font-style: bold; margin-right: 10px; }
.clock-time { font-size: var(--t-display); -unity-font-style: bold; }

/* Tug of war: red's share of the bar is red's chance of winning as it stands (Sim/Excitement.cs). */
.momentum { height: 40px; margin-top: var(--gap-2); background-color: var(--blue); border-radius: var(--radius-xs); overflow: hidden; }
.momentum-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 50%; background-color: var(--red); }
.momentum-mid { position: absolute; left: 50%; top: 0; bottom: 0; width: 4px; margin-left: -2px; background-color: rgba(255, 255, 255, 0.9); }
.momentum-text { position: absolute; top: 0; bottom: 0; font-size: var(--t-small); -unity-font-style: bold; -unity-text-align: middle-center; }
.momentum-text--l { left: 12px; }
.momentum-text--r { right: 12px; }

/* Tale of the tape, mirrored: one row serves both fighters, with the key in the middle. */
.tape { margin-top: var(--gap-2); }
.tape--card { margin-top: var(--gap-3); }
.tape-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-xs);
    background-color: transparent;
}
.tape-val { flex: 1 1 0; font-size: var(--t-body); -unity-font-style: bold; color: var(--ink); }
.tape-val--l { -unity-text-align: middle-right; padding-right: 20px; }
.tape-val--r { -unity-text-align: middle-left; padding-left: 20px; }
.tape-key { width: 60px; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.glyph { width: 30px; height: 30px; margin-right: 10px; color: var(--ink-dim); }
.tape-key .glyph { margin: 0; }

/* On the scoreboard the tape is one row of three chips: red's number, an icon, blue's number. The icon is
   the label. The third chip changes what it shows on a tap anywhere on the scoreboard, and is tinted to
   say so: the whole board is the target, because a chip is shorter than a thumb. */
.chips { flex-direction: row; margin-top: var(--gap-2); margin-left: -4px; margin-right: -4px; }
.stat {
    flex: 1 1 0;
    height: 56px;
    min-height: 56px;
    margin: 0 4px;
    padding: 0 8px;
    border-width: 0;
    border-radius: var(--radius-sm);
    flex-direction: row;
    align-items: center;
    background-color: var(--row);
}
.stat-val { flex: 1 1 0; font-size: var(--t-small); -unity-font-style: bold; color: var(--ink); }
.stat-val--l { -unity-text-align: middle-right; padding-right: 10px; }
.stat-val--r { -unity-text-align: middle-left; padding-left: 10px; }
.stat .glyph { margin: 0; flex-shrink: 0; }

/* A fighter's pod, in the picture's top corner: where it has been hit, and where its balance is. */
.pod {
    position: absolute;
    top: var(--under-board);
    width: var(--pod-w);
    padding: 8px;
    align-items: center;
    background-color: var(--overlay);
    border-radius: var(--radius);
}
.pod--red { left: var(--gap-4); border-top-width: 6px; border-top-color: var(--red); }
.pod--blue { right: var(--gap-4); border-top-width: 6px; border-top-color: var(--blue); }
.hitmap { width: 116px; height: 164px; }
.balance { width: 116px; height: 78px; margin-top: 4px; border-top-width: 2px; border-top-color: var(--surface-line); }
/* What is left in the tank, and what the boxer is doing this moment. */
.tank { width: 116px; height: 10px; margin-top: 4px; border-radius: 5px; background-color: var(--row-lead); overflow: hidden; }
.tank-fill { height: 10px; width: 100%; background-color: var(--accent); }
.tank-fill--low { background-color: var(--warn); }
/* Under the tank, for a boxer trained to tire: what its muscles have left. Below half its drives weaken. */
.tank--reserve { height: 6px; border-radius: 3px; }
.tank-fill--reserve { height: 6px; background-color: var(--reserve); }
.tank-fill--weak { background-color: var(--danger); }
/* A word about the boxer's state under the action badge: ON THE ROPES, TIRED. */
.pod-flag {
    width: 116px;
    margin-top: 4px;
    padding: 2px 0;
    font-size: var(--t-micro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    border-radius: var(--radius-xs);
    color: var(--on-danger);
    background-color: var(--warn);
}
.pod-flag--ropes { background-color: var(--danger); }
.act { width: 116px; height: 36px; margin-top: 4px; font-size: var(--t-micro); -unity-font-style: bold; -unity-text-align: middle-center; color: var(--ink-dim); border-radius: var(--radius-xs); }
.act--punch { color: rgb(12, 16, 22); background-color: var(--ink); }
.act--alarm { color: var(--on-danger); background-color: var(--warn); }

.picture { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

/* ------------------------------------------------------------------ over the picture */

.banner {
    position: absolute;
    top: var(--banner-top);
    left: var(--beside-pods); right: var(--beside-pods);
    -unity-text-align: middle-center;
    font-size: var(--t-banner);
    -unity-font-style: bold;
    letter-spacing: 6px;
    text-shadow: 0 4px 10px var(--shadow);
}
.banner--count { top: var(--count-top); font-size: var(--t-count); letter-spacing: 0; color: var(--warn); }

/* Chat plays (Net/TwitchChat.cs): the corners' votes under the scoreboard, between the pods (the arena), or
   chat's favourite under the board (the free-for-all). Only there with a channel set. */
.chat {
    position: absolute;
    top: var(--under-board);
    left: var(--beside-pods);
    right: var(--beside-pods);
    height: 40px;
    padding: 0 12px;
    font-size: var(--t-micro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink);
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
}
.chat--melee { top: var(--ffa-under-board); left: var(--gap-4); right: var(--gap-4); }

/* Between rounds: the cards and the round's numbers, over the middle of the picture. */
.break {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    top: var(--break-top);
    padding: var(--gap-4);
    background-color: var(--overlay);
    border-radius: var(--radius);
}
.break-title { font-size: var(--t-title); -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 2px; }

.pip {
    position: absolute;
    right: var(--gap-4);
    bottom: var(--over-caption);
    width: 270px;
    height: 360px;
    border-width: 4px;
    border-color: var(--red);
    border-radius: var(--radius);
    overflow: hidden;
    background-color: var(--scrim);
}
.pip--blue { border-color: var(--blue); }

.flash {
    position: absolute;
    width: 200px;
    height: 48px;
    font-size: var(--t-body);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--warn);
    text-shadow: 0 2px 6px var(--shadow);
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
}

/* The walk-on: one corner at a time, named across the lower third of the picture. */
.walkon {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    bottom: var(--walkon-bottom);
    height: 196px;
    flex-direction: row;
    background-color: var(--overlay);
    border-radius: var(--radius);
    overflow: hidden;
}
.walkon-bar { width: 18px; background-color: var(--red); }
.walkon--blue .walkon-bar { background-color: var(--blue); }
.walkon-text { flex: 1 1 0; padding: 10px 24px; justify-content: center; }
.walkon-corner { font-size: var(--t-small); letter-spacing: 4px; color: var(--ink-dim); }
.walkon-name { font-size: var(--t-hero); -unity-font-style: bold; letter-spacing: 2px; }
.walkon-detail { font-size: var(--t-small); color: var(--ink-dim); }

/* Before the first bell, under the walk-on: a corner each side at the ladder's odds, the stake and the coins between them. */
.predict {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    bottom: var(--over-caption);
    height: var(--touch);
    flex-direction: row;
    align-items: center;
}
.predict-btn { flex: 1 1 0; margin: 0; font-size: var(--t-small); -unity-font-style: bold; }
.predict-btn--red { border-left-width: 6px; border-left-color: var(--red); }
.predict-btn--blue { border-right-width: 6px; border-right-color: var(--blue); }
.predict-coins {
    flex: 1 1 0;
    margin: 0 var(--gap-2);
    font-size: var(--t-micro);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--warn);
    text-shadow: 0 2px 6px var(--shadow);
}

/* The brain cam (settings, DEBUG, BRAIN): a bar a joint, grouped legs, torso, left arm, right arm. */
.brain {
    position: absolute;
    left: var(--gap-4);
    bottom: var(--over-caption);
    width: 560px;
    padding: var(--gap-2) var(--gap-3);
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    border-left-width: 6px;
    border-left-color: var(--red);
}
.brain-title { font-size: var(--t-micro); -unity-font-style: bold; letter-spacing: 1px; color: var(--ink); }
.brain-title--blue { color: var(--reserve); }
.brain-bars { flex-direction: row; height: 150px; margin-top: var(--gap-1); }
.brain-column { flex-grow: 1; margin: 0 4px; }
.brain-group { flex-grow: 1; flex-direction: row; align-items: flex-end; }
.brain-slot { flex: 1 1 0; height: 100%; margin: 0 1px; justify-content: flex-end; background-color: var(--row); }
.brain-bar { width: 100%; background-color: var(--accent); }
.brain-bar--neg { background-color: var(--reserve); }
.brain-key { font-size: var(--t-micro); color: var(--ink-dim); -unity-text-align: middle-center; }

/* The punch card (UI/PunchCard.cs): a heavy punch's kinetic chain, bottom right; it gives way to the brain cam. */
.punch-card {
    position: absolute;
    right: var(--gap-4);
    bottom: var(--over-caption);
    width: 560px;
    padding: var(--gap-2) var(--gap-3);
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    border-right-width: 6px;
    border-right-color: var(--red);
}
.punch-card--blue { border-right-color: var(--blue); }
.punch-card-title { font-size: var(--t-micro); -unity-font-style: bold; letter-spacing: 1px; color: var(--ink); margin-bottom: var(--gap-1); }
.punch-card-row { flex-direction: row; align-items: center; height: 34px; }
.punch-card-link { width: 150px; font-size: var(--t-micro); color: var(--ink-dim); }
.punch-card-track { flex-grow: 1; height: 12px; margin-right: var(--gap-2); border-radius: 6px; background-color: var(--row-lead); overflow: hidden; }
.punch-card-bar { height: 12px; background-color: var(--accent); }
.punch-card-value { width: 120px; font-size: var(--t-micro); color: var(--ink); -unity-text-align: middle-right; }
.punch-card-ago { width: 96px; font-size: var(--t-micro); color: var(--ink-dim); -unity-text-align: middle-right; }
.punch-card-verdict { margin-top: var(--gap-1); font-size: var(--t-micro); -unity-font-style: bold; color: var(--accent); white-space: normal; }
.punch-card-verdict--off { color: var(--warn); }
.punch-card-foot { font-size: var(--t-micro); color: var(--ink-dim); white-space: normal; }

/* The commentary: a caption over the bottom of the picture. It fades out when it has nothing new to say,
   so most of the time it is not there and the picture has that space. */
.ticker {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    bottom: var(--over-dock);
    height: 56px;
    font-size: var(--t-body);
    -unity-text-align: middle-left;
    background-color: var(--overlay);
    border-left-width: 6px;
    border-left-color: var(--accent);
    border-radius: var(--radius-sm);
    padding: 0 18px;
}


/* ------------------------------------------------------------------ sheets */

.sheet {
    position: absolute;
    left: var(--gap-4);
    right: var(--gap-4);
    bottom: var(--frame-clear);
    background-color: var(--surface);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-5);
}

/* The result, the same card on the arena and the free-for-all: who won and how, what the pick paid, the punch
   count, and one row of four chips (REPLAY, SHARE, AGAIN or NEXT, MENU), an icon and a short word each, which
   fits a 360 dp phone. */
.res-head { flex-direction: row; align-items: center; height: 104px; }
.res-icon { width: 72px; height: 72px; margin-right: 16px; -unity-background-image-tint-color: var(--warn); }
.res-title { flex: 1 1 0; }
.res-winner { font-size: var(--t-display); -unity-font-style: bold; }
.res-winner--red { color: var(--red); }
.res-winner--blue { color: var(--blue); }
.res-method { font-size: var(--t-body); color: var(--ink-dim); }
/* The pick paid out and the cup's news. */
.res-extra { font-size: var(--t-small); -unity-font-style: bold; color: var(--warn); margin-top: var(--gap-2); }
/* The free-for-all's punch count: its leaders, a line each. */
.res-note { font-size: var(--t-small); color: var(--ink-dim); white-space: normal; margin-top: var(--gap-2); }
.res-actions { margin-top: var(--gap-4); }

/* The three judges' cards, each marked with the colour of the corner it went to. */
.judges { flex-direction: row; margin-top: var(--gap-3); margin-left: -4px; margin-right: -4px; }
.judge {
    flex: 1 1 0;
    height: 96px;
    margin: 0 4px;
    align-items: center;
    justify-content: center;
    background-color: var(--row);
    border-radius: var(--radius-sm);
    border-top-width: 6px;
    border-top-color: rgba(255, 255, 255, 0.22);
}
.judge--red { border-top-color: var(--red); }
.judge--blue { border-top-color: var(--blue); }
.judge-name { font-size: var(--t-micro); letter-spacing: 2px; color: var(--ink-dim); }
.judge-card { font-size: var(--t-title); -unity-font-style: bold; }

/* Both fighters' numbers, with each one's hit map beside its column. */
.res-mid { flex-direction: row; align-items: center; margin-top: var(--gap-3); }
.res-mid .tape { flex: 1 1 0; margin-top: 0; }

/* Tabs: a row of segments over pages that are all the same height, so the sheet does not jump between them.
   The HUD's menu has MATCH, LEAGUE and SETTINGS; the settings have SOUND, DISPLAY and DEBUG. */
.seg { flex-direction: row; height: var(--touch); background-color: var(--row); border-radius: var(--radius); padding: 0; }
.seg-btn {
    flex: 1 1 0;
    margin: 0 3px;
    padding: 0;
    border-width: 0;
    border-radius: var(--radius-sm);
    background-color: transparent;
    color: var(--ink-dim);
    font-size: var(--t-body);
    -unity-font-style: bold;
}
.seg-btn--on { background-color: var(--accent); color: var(--on-accent); }

.page { height: 520px; margin-top: var(--gap-4); }
/* The settings' own pages: three rows of switches at most. */
.s-page { height: 296px; margin-top: var(--gap-2); }
.page-label { margin-top: var(--gap-5); margin-bottom: var(--gap-1); }
.grid { flex-direction: row; margin-top: var(--gap-2); margin-left: -4px; margin-right: -4px; }
.grid-2 { flex: 1 1 0; margin: 0 4px; }
.grid-4 { flex: 1 1 0; margin: 0 4px; padding: 0; }
.grid--last { margin-top: var(--gap-5); }

/* A line to type in (the Twitch channel), its key in front of it. */
.field-row { flex-direction: row; align-items: center; height: var(--touch); margin-top: var(--gap-2); }
.field-key { width: 150px; font-size: var(--t-small); -unity-font-style: bold; color: var(--ink-dim); }
.field { flex: 1 1 0; height: var(--touch); margin: 0; font-size: var(--t-body); }
.field .unity-base-text-field__input {
    background-color: var(--surface-2);
    border-width: 0;
    border-radius: var(--radius-sm);
    padding: 0 16px;
    color: var(--ink);
    font-size: var(--t-body);
    -unity-text-align: middle-left;
}

.lg-row {
    flex-direction: row;
    align-items: center;
    height: 76px;
    margin-bottom: var(--gap-1);
    padding: 0 16px;
    background-color: var(--row);
    border-radius: var(--radius-sm);
}
.lg-row--live { background-color: var(--row-lead); border-left-width: 6px; border-left-color: var(--accent); }
.lg-cell { font-size: var(--t-body); }
.lg-rank { width: 52px; color: var(--ink-dim); }
.lg-name { flex: 1 1 0; -unity-font-style: bold; }
.lg-badge { width: 200px; font-size: var(--t-micro); color: var(--ink-dim); }
.lg-elo { width: 120px; -unity-text-align: middle-right; -unity-font-style: bold; }
.lg-record { width: 150px; -unity-text-align: middle-right; color: var(--ink-dim); }

/* Debug: grows out of the DEBUG chip and lies over the dock rather than moving it. A tap on the frame rate,
   DEBUG, or (hidden) three fingers at once or a long press on the frame rate opens it. */
.debug-panel {
    position: absolute;
    left: var(--gap-4);
    bottom: var(--frame-clear);
    width: 720px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: var(--scrim);
    border-radius: var(--radius);
    border-width: 1px;
    border-color: var(--surface-line);
    padding: var(--gap-3);
}
.dbg-cell { width: 50%; height: 52px; flex-direction: row; align-items: center; padding: 0 8px; }
.dbg-key { width: 140px; font-size: var(--t-micro); letter-spacing: 1px; color: var(--ink-dim); }
/* The value takes the rest of its cell: sized to its text, a count that goes from 99 to 104 is clipped
   for the frame it takes the layout to catch up, and the one-screen audit says so. */
.dbg-val { font-size: var(--t-small); -unity-font-style: bold; flex-grow: 1; }

/* ------------------------------------------------------------------ the testbed (Testbed.uxml) */

.tb-board { height: auto; }
.tb-line { font-size: var(--t-small); white-space: normal; -unity-text-align: middle-center; }
.tb-debug { width: auto; right: var(--gap-4); }
.tb-debug .tb-line { width: 100%; -unity-text-align: middle-left; }

/* ------------------------------------------------------------------ the first screen: choose the boxers */

.menu-root { background-color: var(--scrim); }

/* Every boxer, two to a row, between the frame and the thumb row. The first tap picks red, the next blue,
   and so on; the card says which corner it is in. */
.picker {
    position: absolute;
    top: var(--frame-clear);
    bottom: var(--picker-bottom);
    left: var(--gap-4);
    right: var(--gap-4);
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

/* One boxer: a quarter of the column's height and half its width, whatever the phone's shape. */
.pick {
    width: 49.2%;
    height: 24.2%;
    margin: 0;
    padding: 0;
    border-width: 6px;
    border-color: var(--surface-line);
    border-radius: var(--radius);
    background-color: var(--surface);
    overflow: hidden;
    opacity: 0.6;
    transition-property: opacity, border-color;
    transition-duration: 0.12s;
}
.pick:active { opacity: 0.85; }
.pick--red, .pick--blue { opacity: 1; }
.pick--red { border-color: var(--red); }
.pick--blue { border-color: var(--blue); }
/* A portrait is taken standing, the face in its top third (DevTools 'portraits'); the card shows a wide strip of it,
   so the strip is anchored on the face rather than the middle of the picture. */
.pick-portrait {
    flex-grow: 1;
    background-color: var(--surface);
    background-size: cover;
    background-position-x: center;
    background-position-y: 16%;
}
.pick-foot { height: 104px; padding: 0 16px; justify-content: center; background-color: var(--surface); }
.pick-name { font-size: var(--t-title); -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-left; }
.pick-detail { font-size: var(--t-micro); letter-spacing: 1px; color: var(--ink-dim); -unity-text-align: middle-left; }
/* RED or BLUE, on the portrait of a boxer that is in a corner. */
.pick-tag {
    position: absolute;
    top: var(--gap-2);
    left: var(--gap-2);
    padding: 2px 10px;
    font-size: var(--t-micro);
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--ink);
    border-radius: var(--radius-xs);
    display: none;
}
.pick--red .pick-tag { display: flex; background-color: var(--red); }
.pick--blue .pick-tag { display: flex; background-color: var(--blue); }

/* The thumb row, at the bottom where a thumb is: CUP, FIGHT (the pairing written under the word) and ALL. */
.thumb {
    position: absolute;
    bottom: var(--frame-clear);
    left: var(--gap-4);
    right: var(--gap-4);
    height: var(--fight-h);
    flex-direction: row;
}
.thumb > .btn { height: var(--fight-h); flex-direction: column; align-items: center; justify-content: center; padding: 0 8px; }
.thumb-side { width: 236px; flex-shrink: 0; }
.fight { flex: 1 1 0; margin: 0 var(--gap-2); }
.fight-word { font-size: var(--t-display); -unity-font-style: bold; letter-spacing: 8px; color: var(--on-accent); }
.fight-pair { font-size: var(--t-body); -unity-font-style: bold; letter-spacing: 1px; color: var(--on-accent); align-self: stretch; -unity-text-align: middle-center; }
.thumb-word { font-size: var(--t-display); -unity-font-style: bold; letter-spacing: 4px; }
.thumb-sub { font-size: var(--t-micro); -unity-font-style: bold; letter-spacing: 1px; color: var(--ink-dim); }
.melee { border-width: 4px; border-color: var(--accent); }
.melee .thumb-word { color: var(--accent); }

/* The cup: its bracket a line a match, the next one marked, NEW CUP and FIGHT under it. */
.cup-title { font-size: var(--t-title); -unity-font-style: bold; white-space: normal; }
.cup-bracket { margin-top: var(--gap-3); margin-bottom: var(--gap-2); }
.cup-line {
    height: 60px;
    margin-bottom: var(--gap-1);
    padding: 0 16px;
    font-size: var(--t-small);
    -unity-text-align: middle-left;
    background-color: var(--row);
    border-radius: var(--radius-sm);
}
.cup-line--next { background-color: var(--row-lead); border-left-width: 6px; border-left-color: var(--accent); -unity-font-style: bold; }

/* ------------------------------------------------------------------ the free-for-all (Melee.uxml) */

/* Everybody in the ring, two rows of four under the frame: a colour bar, the name, and where they stand. */
.ffa-board {
    position: absolute;
    top: var(--frame-clear);
    left: var(--gap-4);
    right: var(--gap-4);
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.ffa-row {
    width: 24.4%;
    height: 80px;
    margin-bottom: 6px;
    justify-content: center;
    background-color: var(--overlay);
    border-radius: var(--radius-sm);
    border-top-width: 6px;
    padding: 0 10px;
}
.ffa-name { font-size: var(--t-micro); -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-left; }
.ffa-state { font-size: var(--t-micro); -unity-font-style: bold; color: var(--ink-dim); -unity-text-align: middle-left; }
.ffa-state--count { color: var(--warn); }
.ffa-row--out { opacity: 0.4; }
.ffa-row--out .ffa-name { color: var(--ink-faint); }
.ffa-row--win { background-color: var(--accent-tint); }
.ffa-row--win .ffa-state { color: var(--accent); }
/* The boxer whose own critic expects the most, while they fight (AI FAV). */
.ffa-row--fav .ffa-state { color: var(--accent); }
.ffa-back { margin-right: var(--gap-2); }
/* The referee's call ("ROUND 2", "KIM is counted out"), across the picture under the board and chat's line. */
.ffa-call {
    position: absolute;
    top: var(--ffa-call-top);
    left: var(--gap-4);
    right: var(--gap-4);
    -unity-text-align: middle-center;
    font-size: var(--t-title);
    -unity-font-style: bold;
    color: var(--ink);
    text-shadow: 0 2px 6px var(--shadow);
    white-space: normal;
}
