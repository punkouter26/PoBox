%% Sensor / Reward (Simple) — what the agent sees and what it gets paid for.
flowchart LR
    subgraph Sensors
        GC[Ground contact sensors<br/>torso/head/shins/gloves]
        FR[Foot raycasts down 1m]
        RP[Rigidbody state<br/>pelvis + 14 joints]
    end
    Sensors --> OBS[121 float vector]
    OBS --> NN[Policy network]
    NN --> ACT[Joint drives]
    ACT --> SIM[PhysX step]
    SIM --> R[Reward compute]
    R --> T{Terminal?}
    T -- fall --> EP[EndEpisode]
