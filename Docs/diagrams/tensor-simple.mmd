%% Tensor / Actuator Map (Simple) — observations flow into the network,
%% the network outputs joint targets.
flowchart LR
    subgraph Obs["Observation vector ~121 floats"]
        R[Root state 13]
        J[Joint proprio 98]
        F[Foot contact 8]
        H[Foot height 2]
    end
    Obs --> NN[MLP 121 to 512 to 512 to 512]
    NN --> H1[Mean head]
    NN --> H2[Sigma head]
    H1 --> A[Action ~42 floats in -1,1]
    H2 --> A
    A --> Drives[Per-joint slerp drive<br/>target rotation]
