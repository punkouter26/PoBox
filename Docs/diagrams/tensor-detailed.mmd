%% Tensor / Actuator Map (Detailed) — observation layout, network depth,
%% actuator mapping, joint drive parameters.
flowchart TB
    classDef obs fill:#0c4a6e,stroke:#38bdf8,color:#fff
    classDef nn fill:#7c2d12,stroke:#fb923c,color:#fff
    classDef head fill:#581c87,stroke:#c084fc,color:#fff
    classDef act fill:#064e3b,stroke:#34d399,color:#fff
    classDef drive fill:#3f3f46,stroke:#facc15,color:#fff

    subgraph OBS["Observation layout 1 x 121"]
        direction TB
        O1["[0] pelvis height y<br/>[1-3] pelvis linearVelocity local<br/>[4-6] pelvis angularVelocity/20<br/>[7-9] pelvis up<br/>[10-12] pelvis forward"]:::obs
        O2["Per joint j in 0..13<br/>[13+7j + 0..3] body.localRotation<br/>[13+7j + 4..6] body.angularVelocity/20"]:::obs
        O3["[111] L foot grounded<br/>[112-114] L foot contact normal<br/>[115] R foot grounded<br/>[116-118] R foot contact normal"]:::obs
        O4["[119] L foot ground ray 0..1<br/>[120] R foot ground ray 0..1"]:::obs
    end

    subgraph NET["PPO MLP normalize = true"]
        N0["Input 121"]:::nn
        N1["Dense 121 to 512 + tanh"]:::nn
        N2["Dense 512 to 512 + tanh"]:::nn
        N3["Dense 512 to 512 + tanh"]:::nn
        M["Mean head Linear 512 to D"]:::head
        S["Sigma head Softplus 512 to D"]:::head
        OUT["Action tensor 1 x D<br/>D = DofCount"]:::head
    end

    subgraph MAP["Action mapping zero-centered"]
        direction TB
        AM1["Action i in -1,1<br/>sign * map value to angle<br/>pitch = a >= 0 ? a*high : -a*low"]:::act
        AM2["Per joint pitch roll yaw<br/>skip inactive axes<br/>cursor += DofCount"]:::act
        AM3["Exponential smoothing<br/>smoothed += target - smoothed * alpha<br/>alpha = 1 - exp -dt/smoothing"]:::act
    end

    subgraph DRIVE["PhysX joint drives"]
        direction TB
        D1["ConfigurableJoint.slerpDrive<br/>positionSpring = baseSpring * springScale * strengthScale"]:::drive
        D2["positionDamper = baseDamper"]:::drive
        D3["maximumForce = baseMaxForce * strengthScale"]:::drive
        D4["targetRotation = Quaternion.Euler<br/>sign*pitch, sign*roll, sign*yaw"]:::drive
    end

    OBS --> N0 --> N1 --> N2 --> N3
    N3 --> M --> OUT
    N3 --> S --> OUT
    OUT --> AM1 --> AM2 --> AM3 --> D1
    D1 --> D2 --> D3 --> D4
