%% Hyperparameters (Detailed) — full PPO/SAC configuration matrix.
flowchart TB
    classDef hp fill:#064e3b,stroke:#34d399,color:#fff
    classDef net fill:#7c2d12,stroke:#fb923c,color:#fff
    classDef rs fill:#581c87,stroke:#c084fc,color:#fff
    classDef cur fill:#0c4a6e,stroke:#38bdf8,color:#fff
    classDef sp fill:#3f3f46,stroke:#facc15,color:#fff

    subgraph TR["Trainer"]
        T1["trainer_type ppo"]:::hp
        T2["max_steps 15M to 50M"]:::hp
        T3["time_horizon 256"]:::hp
        T4["summary_freq 50000"]:::hp
        T5["checkpoint_interval 500000"]:::hp
        T6["keep_checkpoints 5 to 25"]:::hp
    end

    subgraph HP["PPO hyperparameters"]
        H1["batch_size 2048"]:::hp
        H2["buffer_size 20480"]:::hp
        H3["learning_rate 0.0003"]:::hp
        H4["beta 0.005"]:::hp
        H5["epsilon 0.2"]:::hp
        H6["lambd 0.95"]:::hp
        H7["num_epoch 3"]:::hp
        H8["learning_rate_schedule linear or constant"]:::hp
    end

    subgraph NET["Network settings"]
        N1["normalize true"]:::net
        N2["hidden_units 512"]:::net
        N3["num_layers 3"]:::net
        N4["memory LSTM 128 x 64 self-play only"]:::net
    end

    subgraph RS["Reward signals"]
        R1["extrinsic gamma 0.999 balance"]:::rs
        R2["extrinsic gamma 0.99 self-play"]:::rs
        R3["strength 1.0"]:::rs
    end

    subgraph CURR["Curricula"]
        direction TB
        C1["strength_scale<br/>WeakMotors 0.6, MediumMotors 0.8, FullMotors 1.0"]:::cur
        C2["shove_force_max<br/>CalmAir 0, GentleShoves 60, LightShoves 120, FullShoves 300"]:::cur
        C3["cube_speed_max<br/>NoCubes 0, SoftCubes 6, ContestCubes 12"]:::cur
        C4["speed_command_max locomotion<br/>StandStill 0, Shuffle 0.3, Step 0.7, Walk 1.0"]:::cur
    end

    subgraph SP["Self-play"]
        D1["save_steps 100000"]:::sp
        D2["team_change 200000"]:::sp
        D3["swap_steps 20000"]:::sp
        D4["window 10"]:::sp
        D5["play_against_latest_model_ratio 0.5"]:::sp
        D6["initial_elo 1200"]:::sp
    end

    TR --> HP --> NET --> RS --> CURR
    NET --> SP
