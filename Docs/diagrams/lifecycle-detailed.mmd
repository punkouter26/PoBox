%% Lifecycle (Detailed) — tensor / memory flow + Sentis execution.
%% PoBox Unity ML-Agents pipeline with explicit tensor shapes and buffers.
flowchart TD
    classDef csharp fill:#1f2937,stroke:#60a5fa,color:#fff
    classDef sentis fill:#7c2d12,stroke:#fb923c,color:#fff
    classDef physx fill:#064e3b,stroke:#34d399,color:#fff
    classDef buf fill:#3b0764,stroke:#c084fc,color:#fff

    S0[Academy stepper<br/>DefaultExecutionOrder -100]:::csharp

    subgraph OBS["1. CollectObservations VectorSensor"]
        O1[Root: pos.y, vel_local, angvel/20, up, forward<br/>13 floats]:::csharp
        O2[Per-joint: localRotation, angvel/20<br/>7 floats x 14 joints = 98]:::csharp
        O3[Feet: grounded + normal L/R<br/>8 floats]:::csharp
        O4[Foot-height raycasts<br/>2 floats]:::csharp
        O5[Opponent-relative pelvis/head/glove pos<br/>19 floats]:::csharp
    end

    subgraph ONNX["2. Unity Inference Engine (Sentis)"]
        T0[Input tensor shape 1 x 121 float32]:::buf
        N1[Dense 512 + tanh]:::sentis
        N2[Dense 512 + tanh]:::sentis
        N3[Dense 512 + tanh]:::sentis
        H1[Gaussian mean head]:::sentis
        H2[Gaussian sigma head]:::sentis
        T1[Action tensor 1 x ~42 float32]:::buf
    end

    subgraph APPLY["3. Apply Actions FixedUpdate"]
        A1[OnActionReceived buffers actions]:::csharp
        A2[Rig.ApplyActions maps -1,1 to<br/>pitch/roll/yaw per joint]:::csharp
        A3[Optional muscle-lag smoothing<br/>alpha = 1 - exp -dt/0.1]:::csharp
    end

    subgraph PHYS["4. PhysX ArticulationBody step 0.02 s"]
        P1[Slerp drive to targetRotation]:::physx
        P2[Stamina attenuates spring:<br/>0.35 + 0.65*anaerobic^1.2]:::physx
        P3[Ground contact sensors]:::physx
    end

    subgraph TERM["5. Terminal / truncation"]
        R1[Reward_Balance or Reward_Locomotion<br/>adds per-step extrinsic]:::csharp
        T2{Fallen?<br/>ground sensor or<br/>head < 0.4 * start}:::csharp
        E1[AddReward -1 balance only<br/>EndEpisode]:::csharp
        E2[Buffer push to PPO<br/>step += 1]:::buf
    end

    S0 --> O1 --> O2 --> O3 --> O4 --> O5 --> T0
    T0 --> N1 --> N2 --> N3 --> H1 --> T1
    T0 --> N2 --> H2 --> T1
    T1 --> A1 --> A2 --> A3 --> P1 --> P2 --> P3
    P3 --> R1 --> T2
    T2 -- yes --> E1
    T2 -- no --> E2 --> S0
    E1 -.next episode.-> S0
