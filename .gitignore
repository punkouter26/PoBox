# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
# Anchored to the repo root. Unanchored, "[Bb]uild/" also matched
# Assets/Scripts/Editor/Build/, which quietly kept Build_Android.cs -- the
# file that produces the Play artifact, holds the keystore paths and owns
# SHIP_SCENES -- out of version control entirely. A fresh clone could not
# build for Android and nothing said so.
/[Bb]uild/
/[Bb]uilds/
[Ll]ogs/
.utmp/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
# Per-build reports written by BuildReportInspector: GUID-named, one per build.
/[Aa]ssets/BuildReports/

# Training runs: Tools/MuJoCo/train_nick.py writes results/nick/<run>.
results/

# Asset store tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# IDE
.idea/
.vs/
.vsconfig
*.csproj
*.slnx
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
*.stackdump

# Claude Code local settings and session state
.claude/settings.local.json
.claude/state/*.json
.claude/state/*.jsonl
.claude/state/*.txt
.claude/state/*.md

# Unity addressables / builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# Play publishing tooling venv — kept apart from Tools/MuJoCo/.venv, whose
# pins are load-bearing for training.
Tools/publish-venv/

# Python bytecode from the Tools/ scripts
__pycache__/

# Written by the Unity Performance Testing package on every batchmode run.
/[Aa]ssets/Resources/PerformanceTestRun*.json*

SmokeBuild/
SmokeBuildWalk/
WatchBuild/
shots/

# MuJoCo plugin's runtime log and trainer stderr dumps — run artifacts.
MUJOCO_LOG.TXT
Tools/MuJoCo/*.err
