[
 {
  "run": "bench_match",
  "viewer": false,
  "cmd": [
   "tools/bench_match.py",
   "--write",
   "logs/bench_match.json"
  ]
 },
 {
  "run": "shipped_matt",
  "viewer": false,
  "cmd": [
   "tools/onnx_to_pt.py",
   "--onnx",
   "../Assets/Boxers/Matt/policy.onnx",
   "--out",
   "checkpoints/shipped/policy_matt.pt"
  ]
 },
 {
  "run": "f2_matt",
  "viewer": true,
  "cmd": [
   "tools/train_resilient.py",
   "--run-name",
   "f2_matt",
   "--stage",
   "footwork",
   "--xml",
   "models/v2/matt_solo.xml",
   "--resume",
   "checkpoints/shipped/policy_matt.pt",
   "--more-iters",
   "400",
   "--max-hours",
   "0.4",
   "--speed-limit",
   "--rsi",
   "0.5",
   "--style-w",
   "0.3",
   "--max-std",
   "0.35",
   "--selfcontact-w",
   "0.02",
   "--keep-old-runs"
  ]
 },
 {
  "run": "exam_f2_matt",
  "viewer": false,
  "env": {
   "PYTHONPATH": ".mj350"
  },
  "cmd": [
   "tools/footwork_c.py",
   "--name",
   "matt",
   "--exam",
   "--policy",
   "checkpoints/f2_matt/latest.pt",
   "--seeds",
   "10",
   "--episodes",
   "3",
   "--json",
   "logs/exam_f2_matt.json"
  ]
 },
 {
  "run": "rc2_matt",
  "viewer": true,
  "cmd": [
   "tools/train_resilient.py",
   "--gauntlet",
   "--run-name",
   "rc2_matt",
   "--stage",
   "match",
   "--models",
   "models/v2",
   "--name",
   "matt",
   "--resume",
   "checkpoints/m9_matt/latest_matt.pt",
   "--against",
   "zombie=checkpoints/sf1_zombie/latest_zombie.pt",
   "nick=checkpoints/m1_nick/latest_nick.pt",
   "sokol=checkpoints/m2_sokol/latest_sokol.pt",
   "kim=checkpoints/m7_kim/latest_kim.pt",
   "trump=checkpoints/onnx/match_trump.pt",
   "grandma=checkpoints/m1_grandma/latest_grandma.pt",
   "grandpa=checkpoints/m1_grandpa/latest_grandpa.pt",
   "--daze",
   "--obs-state",
   "--hit-push",
   "0.6",
   "--stagger-v",
   "5",
   "--hurt-full",
   "400",
   "--body-drain",
   "0.0025",
   "--hit-w",
   "1.5",
   "--taken-w",
   "1.0",
   "--block-w",
   "0.5",
   "--fall-penalty",
   "12",
   "--selfcontact-w",
   "0.02",
   "--repeat-decay",
   "0.7",
   "--combo-w",
   "0.1",
   "--hurt-start",
   "0.2",
   "--clinch-w",
   "0.1",
   "--rope-w",
   "0.05",
   "--cutoff-w",
   "0.05",
   "--sep-max",
   "3.5",
   "--num-envs",
   "4608",
   "--more-iters",
   "600",
   "--max-hours",
   "0.75",
   "--max-std",
   "0.35",
   "--handover",
   "logs/handover_v2_matt.npz",
   "--handover-share",
   "0.5",
   "--done-when",
   "hits_per_s>=1.2,falls<=0.03,repeat_share<=0.6",
   "--done-window",
   "40"
  ]
 },
 {
  "run": "exam_rc2_matt",
  "viewer": false,
  "env": {
   "PYTHONPATH": ".mj350"
  },
  "cmd": [
   "tools/exam_v2.py",
   "--only",
   "matt",
   "--trials",
   "60",
   "--rounds",
   "12",
   "--json",
   "logs/exam_rc2_matt.json",
   "--book",
   "logs/book_punch.json"
  ]
 }
]